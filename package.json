{
  "name": "ecommerceplaywright",
  "version": "1.0.0",
  "description": "End-to-end BDD tests for https://practicesoftwaretesting.com with Playwright Test, playwright-bdd and TypeScript.",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test --project=chromium",
    "test:all-browsers": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --project=chromium --grep @smoke",
    "test:regression": "bddgen && playwright test --project=chromium --grep @regression",
    "test:headed": "bddgen && playwright test --project=chromium --headed",
    "test:ui": "bddgen && playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "bddgen && tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "playwright-bdd": "^9.2.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=20"
  }
}
